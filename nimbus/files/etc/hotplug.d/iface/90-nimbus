#!/bin/sh

case "${ACTION:-}" in
	ifup|ifupdate|ifdown)
		;;
	*)
		exit 0
		;;
esac

[ -f /var/run/nimbus/state.json ] || exit 0
[ -x /usr/bin/ucode ] || exit 0
[ -f /usr/share/nimbus/supervisor.uc ] || exit 0

/usr/bin/ucode -S -L /usr/share/nimbus /usr/share/nimbus/supervisor.uc --hotplug >/dev/null 2>&1 || true

exit 0
