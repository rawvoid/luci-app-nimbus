#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

NIMBUS_LIB="/usr/share/nimbus"
SUPERVISOR_UC="/usr/share/nimbus/supervisor.uc"
UCODE_BIN="/usr/bin/ucode"

compute_gomemlimit() {
	cfg_val="$1"
	if [ -n "$cfg_val" ] && [ "$cfg_val" != "auto" ]; then
		printf '%s' "$cfg_val"
		return 0
	fi

	mem_kb=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null || printf '262144')
	case "$mem_kb" in
		*[!0-9]*|'') mem_kb=262144 ;;
	esac

	mib=$(( (mem_kb * 4) / 10 / 1024 ))
	if [ "$mib" -gt 256 ]; then
		mib=256
	elif [ "$mib" -lt 32 ]; then
		mib=32
	fi

	printf '%sMiB' "$mib"
}

start_service() {
	enabled=0
	raw_memlimit="auto"
	config_load nimbus
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get raw_memlimit global gomemlimit "auto"
	gomemlimit=$(compute_gomemlimit "$raw_memlimit")

	if ! "$UCODE_BIN" -S -L "$NIMBUS_LIB" "$SUPERVISOR_UC" --prepare-start; then
		return 1
	fi

	procd_open_instance "nimbus"
	procd_set_param command "$UCODE_BIN" -S -L "$NIMBUS_LIB" "$SUPERVISOR_UC"
	procd_set_param env GOMEMLIMIT="$gomemlimit" GOGC="50"
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	enabled=0
	config_load nimbus
	config_get_bool enabled global enabled 0
	if [ "$enabled" -ne 1 ]; then
		stop
		return 0
	fi

	rc=0
	"$UCODE_BIN" -S -L "$NIMBUS_LIB" "$SUPERVISOR_UC" --prepare-reload || rc=$?

	if [ "$rc" -eq 10 ]; then
		return 0
	elif [ "$rc" -eq 0 ]; then
		start
		return 0
	fi

	if command -v procd_kill >/dev/null 2>&1; then
		procd_kill "nimbus" "" >/dev/null 2>&1 || true
	fi
	return "$rc"
}

stop_service() {
	"$UCODE_BIN" -S -L "$NIMBUS_LIB" "$SUPERVISOR_UC" --stop >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger "nimbus"
}
