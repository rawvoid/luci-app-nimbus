msgstr "LAN 逻辑接口"

msgid "Logical OpenWrt network interfaces whose client traffic is intercepted."
msgstr "需要透明代理接管流量的 OpenWrt LAN 逻辑接口。"

msgid "WAN Interfaces"
msgstr "WAN 逻辑接口"

msgid "Logical WAN interfaces whose public IPv4/IPv6 prefixes are automatically bypassed in Main Router topology."
msgstr "主路由模式下自动提取公网 IPv4/IPv6 前缀加入绕行集合的 WAN 逻辑接口。"

msgid "Enable IPv4 Proxy"
msgstr "启用 IPv4 代理"

msgid "Enable IPv6 Proxy"
msgstr "启用 IPv6 代理"

msgid "IPv4 and IPv6 proxy cannot both be disabled."
msgstr "IPv4 与 IPv6 代理不可同时禁用。"

msgid "Proxy Router Outbound Traffic"
msgstr "代理路由器本机出站流量"

