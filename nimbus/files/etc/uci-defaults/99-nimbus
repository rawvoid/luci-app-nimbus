#!/bin/sh

mkdir -p \
	/etc/nimbus/composers \
	/etc/nimbus/profiles \
	/etc/nimbus/lists/local \
	/etc/nimbus/lists/cache \
	/etc/nimbus/bin

if [ ! -f /etc/nimbus/lists/local/custom_direct.txt ]; then
	printf '# Custom direct IPv4/IPv6 CIDR entries (one per line)\n' > /etc/nimbus/lists/local/custom_direct.txt
fi

if [ -r /lib/functions.sh ]; then
	# shellcheck disable=SC1091
	. /lib/functions.sh
	group_exists nimbus || group_add_next nimbus >/dev/null 2>&1 || true
fi

exit 0
